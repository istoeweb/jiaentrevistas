# Conexao com o banco Postgres.
# Local (Docker/Postgres): 
DATABASE_URL=postgres://postgres:postgres@localhost:5433/jia

# Supabase (exemplo — use a "Connection string" do painel, aba Database):
# Prefira o Connection Pooler (porta 6543) para apps serverless/limite de conexoes:
# DATABASE_URL=postgres://postgres.<ref>:<senha>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Ou a conexao direta (porta 5432):
# DATABASE_URL=postgres://postgres:<senha>@db.<ref>.supabase.co:5432/postgres

# SSL: para hosts remotos (Supabase) o SSL e habilitado automaticamente.
# Para forcar desabilitar (ex.: local sem TLS), defina:
# PGSSL=disable

# Segredo para assinar os tokens JWT (troque em producao):
JWT_SECRET=dev-secret-change-me

# Porta do servidor (opcional):
# PORT=3000
